        except Exception as exc:
            transaction.update({'failed_time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                'status': 'failed', 'error': str(exc)})
            if attempted.exists():
                with attempted.open('a') as handle:
                    handle.write(json.dumps(transaction, ensure_ascii=False) + '\n')
            raise
        finally:
            if capture.poll() is None:
                capture.terminate()
            capture.wait(timeout=5)
            with (CASE / 'logs/board-bridge-audit.jsonl').open('a') as handle:
                handle.write(json.dumps({'argv': capture_argv, 'exit_code': capture.returncode,
                                         'output': output_file.read_text()}, ensure_ascii=False) + '\n')
    result.append(output_file.read_text())
    for role in ('a-core', 'sm'):
        path = CASE / f'logs/{name}-{role}.log'
        if path.exists():
            result.append(f'\n{role} raw log tail:\n' + path.read_bytes()[-32000:].decode('utf-8', errors='replace'))
    return '\n'.join(result)

def uuu_flash_case_bootloader():
