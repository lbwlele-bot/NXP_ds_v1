                    if (barrier and barrier.get('state') == 'active'
                            and barrier.get('pid') == capture.pid
                            and set(roles) == {'a-core', 'sm'}):
                        break
                time.sleep(.1)
            else:
                raise RuntimeError('Capture reader READY barrier not reached; no case RAM boot')
            transaction['ready'] = barrier
            with attempted.open('x') as handle:
                handle.write(json.dumps(transaction, ensure_ascii=False) + '\n')
            LAST_SERIAL = ''
            result.append(run(['sudo', '-n', UUU, '-V', '-t', '5', '-T', '5',
                               '-b', 'spl', binding['path']], 90))
            deadline = time.monotonic() + 45
            usb_after = ''
            while time.monotonic() < deadline:
                usb_after = run(['sudo', '-n', UUU, '-lsusb'])
                if exact_usb_serial(usb_after, 'FB', serial):
                    break
                time.sleep(2)
            else:
                raise RuntimeError('Case RAM boot did not establish exact reviewed MX943 FB target')
            result.append(usb_after)
            transaction.update({'completed_time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                'status': 'completed', 'usb_after': usb_after})
