    if ram_receipt.get('usb_serial') != serial:
        raise RuntimeError('Completed case RAM-boot receipt belongs to a different USB serial; no SD write')
    if ram_receipt.get('usb_identity_receipt_sha256') != receipt_sha256:
        raise RuntimeError('Completed case RAM-boot receipt was authorized by a different USB identity receipt')
    attempted = CASE / (CASE_WRITE_RECEIPT + '.attempted.jsonl')
    completed = CASE / (CASE_WRITE_RECEIPT + '.completed.json')
    if completed.exists():
        raise RuntimeError('Case SD bootloader write already completed; do not rewrite')
    if attempted.exists():
        raise RuntimeError('Case SD bootloader write already attempted; inspect evidence before retry')
    one_board()
    usb_before = run(['sudo', '-n', UUU, '-lsusb'])
    require_exact_usb_row(usb_before, 'FB', serial)
    recipe = run(['sudo', '-n', UUU, '-bshow', 'sd'])
    require_sd_bootloader_recipe(recipe)
    consumption = record_usb_receipt_consumption(
        binding, receipt, receipt_sha256, 'sd_bootloader', 'uuu_flash_case_bootloader')
    transaction = {'time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                   'status': 'attempted', 'phase': 'sd_bootloader',
                   'artifact_binding': binding['key'], 'artifact_id': binding['id'],
                   'artifact_size': binding['size'], 'artifact_sha256': binding['sha256'],
                   'build_recipe': binding['build_recipe'],
                   'target_module': binding['target_module'],
                   'usb_serial': serial, 'target_protocol': 'FB 1FC9:0152',
                   'usb_identity_receipt_sha256': receipt_sha256,
                   'usb_identity_receipt_path': CASE_USB_RECEIPT_REL,
                   'usb_vid_pid': '0x1FC9:0x0152',
                   'usb_identity_consumed_at': consumption['time'],
                   'recipe': binding['sd_bootloader_recipe'], 'sd_dev': 1}
    with attempted.open('x') as handle:
        handle.write(json.dumps(transaction, ensure_ascii=False) + '\n')
    try:
        write_output = run(['sudo', '-n', UUU, '-V', '-t', '5', '-T', '5',
                            '-e', 'sd_dev=1', '-b', 'sd', binding['path']], 90)
        require_case_write_markers(write_output)
