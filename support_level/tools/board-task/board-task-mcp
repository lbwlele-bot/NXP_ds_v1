    with output_file.open('w') as output:
        capture = subprocess.Popen(capture_argv, stdout=output, stderr=subprocess.STDOUT)
        try:
            deadline = time.monotonic() + 8
            barrier = None
            while time.monotonic() < deadline and capture.poll() is None:
                if ready.exists():
                    barrier = yaml.safe_load(ready.read_text())
                    roles = barrier.get('roles', []) if barrier else []
                    if isinstance(roles, str):
