def sha256_file(path):
    digest = hashlib.sha256()
    with path.open('rb') as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()

def child_path(root, relative, label):
    if not isinstance(relative, str) or not relative or Path(relative).is_absolute():
        raise RuntimeError(label + ' must be a non-empty relative path')
    root = root.resolve(strict=True)
    candidate = (root / relative).resolve(strict=True)
    try:
        candidate.relative_to(root)
    except ValueError as exc:
        raise RuntimeError(label + ' escapes its pinned root') from exc
    return candidate

def relative_path(base, relative, label):
    if not isinstance(relative, str) or not relative or Path(relative).is_absolute():
        raise RuntimeError(label + ' must be a non-empty relative path')
    return (Path(base).resolve(strict=True) / relative).resolve(strict=True)

def atomic_write_json(path, payload):
    """Write a receipt atomically; a reader never sees a partial JSON file."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    data = json.dumps(payload, ensure_ascii=False, indent=2) + '\n'
    temporary = path.with_name(path.name + '.tmp.' + uuid.uuid4().hex)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary.exists():
            temporary.unlink()

def _strip_ansi(text):
    return re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', text)

def _usb_hex(value):
    value = value.strip()
    if not re.fullmatch(r'0[xX][0-9A-Fa-f]+', value):
        return value
    return '0x' + value[2:].upper()

def parse_uuu_usb_table(output):
    """Parse the real tabular uuu -lsusb device list by row.

    The parser locates the real header and '=' separator, then splits complete
    rows.  It never searches arbitrary substrings, so a value from one row
    cannot satisfy a check on another row.
    """
    if not isinstance(output, str) or not output.strip():
        raise RuntimeError('uuu -lsusb output is empty')
    lines = [_strip_ansi(line).rstrip('\r') for line in output.splitlines()]
    header_index = None
    for index, line in enumerate(lines):
        if all(token in line for token in
               ('Path', 'Chip', 'Pro', 'Vid', 'Pid', 'Serial_no')):
            header_index = index
            break
    if header_index is None:
        raise RuntimeError('uuu -lsusb output has no USB table header')
    separator_index = None
    for index in range(header_index + 1, min(header_index + 4, len(lines))):
        if re.fullmatch(r'\s*=+\s*', lines[index]):
            separator_index = index
            break
    if separator_index is None:
        raise RuntimeError('uuu -lsusb output has no USB table separator')
    rows = []
    for line in lines[separator_index + 1:]:
        if not line.strip():
            if rows:
                break
            continue
        fields = [field.strip() for field in line.strip().split('\t')]
        if len(fields) < 7:
            match = re.fullmatch(
                r'\s*(\S+)\s+(.*?)\s+((?i:SDPS|FB)):\s+'
                r'(0[xX][0-9A-Fa-f]+)\s+(0[xX][0-9A-Fa-f]+)\s+'
                r'(0[xX][0-9A-Fa-f]+)\s+([0-9A-Za-z]+)\s*', line)
            if not match:
                if rows:
                    break
                continue
            path, chip, protocol, vid, pid, bcd, serial = match.groups()
            fields = [path, chip, protocol + ':', vid, pid, bcd, serial]
        while len(fields) > 7 and fields[0] == '':
            fields.pop(0)
        if len(fields) != 7:
            if rows:
                break
            continue
        path, chip, protocol, vid, pid, bcd, serial = fields
        rows.append({
            'path': path,
            'chip': chip,
            'protocol': protocol.rstrip(':').upper(),
            'protocol_token': protocol,
            'vid': _usb_hex(vid),
            'pid': _usb_hex(pid),
            'bcd_version': bcd,
            'serial': serial.upper(),
            'raw': line.strip(),
        })
    if not rows:
        raise RuntimeError('uuu -lsusb output has no device rows')
    return rows

def select_exact_usb_row(output, protocol, serial=None):
    """Select exactly one known TARGET row and check every field on that row.

    SDPS rows identify MX943.  Real FB rows may have a blank Chip column.
    Any second known target, a wrong protocol, wrong VID/PID, wrong chip or
    wrong serial is rejected before the caller can act.
    """
    if protocol not in ('SDPS', 'FB'):
        raise RuntimeError('Unsupported USB protocol: ' + str(protocol))
    rows = parse_uuu_usb_table(output)
    targets = [row for row in rows if row['protocol'] in ('SDPS', 'FB')]
    if not targets:
        raise RuntimeError('No known SDPS/FB target row in uuu -lsusb output')
    if len(targets) != 1:
        raise RuntimeError('Multiple known USB target rows; refusing ambiguous or cross-row composition')
    row = targets[0]
    if row['protocol'] != protocol:
        raise RuntimeError('USB protocol mismatch: expected ' + protocol
                           + ', row reports ' + row['protocol'])
    expected = {
        'SDPS': {'chip': 'MX943', 'vid': CASE_USB_SDPS_VID, 'pid': CASE_USB_SDPS_PID},
        'FB': {'chip': None, 'vid': CASE_USB_FB_VID, 'pid': CASE_USB_FB_PID},
    }[protocol]
    if protocol == 'SDPS':
        if row['chip'] != 'MX943':
            raise RuntimeError('SDPS target row does not identify MX943')
    elif row['chip'] not in ('', 'MX943'):
        raise RuntimeError('FB target row has an unexpected chip identity')
    if row['vid'] != expected['vid'] or row['pid'] != expected['pid']:
        raise RuntimeError(
            'USB VID/PID mismatch on the target row: expected '
            + expected['vid'] + ':' + expected['pid'] + ', row reports '
            + row['vid'] + ':' + row['pid'])
    observed = row['serial'].upper()
    if not CASE_USB_SERIAL_RE.fullmatch(observed):
        raise RuntimeError('USB target row serial is not one 16-hex value')
    row['serial'] = observed
    if serial is not None and observed != serial.upper():
        raise RuntimeError('USB target row serial does not match the reviewed serial')
    return row

def require_exact_usb_row(output, protocol, serial=None):
    return select_exact_usb_row(output, protocol, serial)

def exact_usb_serial(output, protocol, serial):
    try:
        select_exact_usb_row(output, protocol, serial)
    except RuntimeError:
        return False
    return True

