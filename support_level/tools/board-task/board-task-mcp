def verify_case_software_state(binding):
    """Re-check the case compile state, build recipe and output identity."""
    case_root = binding['case_root']
    if case_root.name != binding['case_id']:
        raise RuntimeError('Case artifact root does not match the pinned case id')
    state_path = case_root / 'state/software-state.yaml'
    if not state_path.is_file():
        raise RuntimeError('Case software-state.yaml is missing; refuse board consumption')
    state = yaml.safe_load(state_path.read_text())
    try:
        component = state['targets']['imx-mkimage']['components']['imx-mkimage']
    except (KeyError, TypeError) as exc:
        raise RuntimeError('Case software-state has no imx-mkimage component') from exc
    values = component.get('configuration', {}).get('values', {})
    expected_values = {
        'compile_profile.parameter.recipe.value': binding['build_recipe'],
        'compile_profile.parameter.soc.value': 'iMX94',
        'compile_profile.parameter.silicon_revision.value': 'A0',
        'compile_profile.parameter.lpddr_type.value': 'lpddr4',
    }
    for key, expected in expected_values.items():
        if values.get(key) != expected:
            raise RuntimeError('Case software-state ' + key + ' is not the reviewed value')
    matches = []
    for output in component.get('outputs') or []:
        if not isinstance(output, dict):
            continue
        try:
            output_path = Path(output.get('path') or '').resolve(strict=True)
        except (OSError, RuntimeError):
            continue
        if output_path == binding['path']:
            matches.append(output)
    if len(matches) != 1:
        raise RuntimeError('Case software-state does not contain exactly one pinned flash.bin output')
    output = matches[0]
    if output.get('stat', {}).get('size') != binding['size']:
        raise RuntimeError('Case software-state output size is not the reviewed value')
    if output.get('sha256') != 'sha256:' + binding['sha256']:
        raise RuntimeError('Case software-state output SHA-256 is not the reviewed value')
    return state_path

def case_usb_receipt_path(binding):
    usb = binding['usb_identity']
    if usb.get('receipt') != CASE_USB_RECEIPT_REL:
        raise RuntimeError('Case USB identity receipt path is not the fixed case-scoped path')
    case_root = binding['case_root']
    if case_root.name != binding['case_id']:
        raise RuntimeError('Case USB identity receipt root is not the pinned case')
    path = (case_root / CASE_USB_RECEIPT_REL).resolve()
    try:
        path.relative_to(case_root.resolve(strict=True))
    except (ValueError, OSError) as exc:
        raise RuntimeError('Case USB identity receipt escapes the selected case') from exc
    return path

def _require_iso_timestamp(value, label):
    if not isinstance(value, str) or not value.strip():
        raise RuntimeError(label + ' timestamp is missing')
    try:
        parsed = datetime.datetime.fromisoformat(value)
    except ValueError as exc:
        raise RuntimeError(label + ' timestamp is invalid') from exc
    if parsed.tzinfo is None:
        raise RuntimeError(label + ' timestamp has no timezone')
    return parsed

def load_usb_identity_receipt(binding, receipt_path=None):
    """Validate the one case-scoped receipt and its embedded raw evidence."""
    path = Path(receipt_path) if receipt_path is not None else case_usb_receipt_path(binding)
    if not path.is_file():
        raise RuntimeError(
            'Case USB identity receipt missing. Run bcu_identity in this session, then '
            'confirm_case_usb_identity; no arbitrary serial/path/hash is accepted.')
    try:
        receipt = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise RuntimeError('Case USB identity receipt is unreadable') from exc
    if not isinstance(receipt, dict):
        raise RuntimeError('Case USB identity receipt is not an object')
    if receipt.get('schema_version') != CASE_USB_RECEIPT_SCHEMA:
        raise RuntimeError('Case USB identity receipt schema is not the reviewed version')
    if receipt.get('status') != CASE_USB_RECEIPT_STATUS:
        raise RuntimeError('Case USB identity receipt status is not usb_identity_confirmed')
    if receipt.get('scope') != CASE_USB_RECEIPT_SCOPE:
        raise RuntimeError('Case USB identity receipt scope is not usb_identity_only')
    for forbidden in ('ram_boot', 'ram_booted', 'runtime', 'phase', 'completed'):
        if forbidden in receipt:
            raise RuntimeError('Case USB identity receipt must not claim ' + forbidden)
    if receipt.get('case_id') != binding['case_id']:
        raise RuntimeError('Case USB identity receipt names the wrong case')
    artifact = receipt.get('artifact')
    if not isinstance(artifact, dict):
        raise RuntimeError('Case USB identity receipt has no artifact identity')
    expected_artifact = {
        'binding_key': binding['key'],
        'artifact_id': binding['id'],
        'case_relative_path': binding['relative_path'],
        'size': binding['size'],
        'sha256': binding['sha256'],
        'build_recipe': binding['build_recipe'],
        'target_module': binding['target_module'],
    }
    for key, expected in expected_artifact.items():
        if artifact.get(key) != expected:
            raise RuntimeError('Case USB identity receipt artifact ' + key
                               + ' is not the reviewed identity')
    _require_iso_timestamp(receipt.get('timestamp'), 'Case USB identity receipt')
    bcu = receipt.get('bcu_identity')
    if not isinstance(bcu, dict):
        raise RuntimeError('Case USB identity receipt has no BCU identity')
    raw_bcu = bcu.get('raw_output')
    if not isinstance(raw_bcu, str) or not raw_bcu.strip():
        raise RuntimeError('Case USB identity receipt has no raw BCU evidence')
    for value in ('Auto recognized the board: ' + BOARD,
                  'FTDI EEPROM SN: ' + ADAPTER,
                  'SoC Info: i.MX943 Rev A0', 'MFS5600', 'done'):
        if value not in raw_bcu:
            raise RuntimeError('Case USB identity receipt raw BCU evidence is incomplete')
    if bcu.get('board') != BOARD or bcu.get('ftdi_serial') != ADAPTER:
        raise RuntimeError('Case USB identity receipt BCU identity is not the reviewed controller')
    if bcu.get('soc_revision') != 'A0' or bcu.get('pmic') != 'MFS5600':
        raise RuntimeError('Case USB identity receipt SoC/PMIC identity is not the reviewed A0 target')
    _require_iso_timestamp(bcu.get('observed_at'), 'Case USB identity receipt BCU')
    if bcu.get('raw_output_sha256') != hashlib.sha256(raw_bcu.encode()).hexdigest():
        raise RuntimeError('Case USB identity receipt raw BCU evidence hash mismatch')
    usb = receipt.get('usb')
    if not isinstance(usb, dict):
        raise RuntimeError('Case USB identity receipt has no USB identity')
    if usb.get('protocol') != 'SDPS':
        raise RuntimeError('Case USB identity receipt protocol is not SDPS')
    serial = usb.get('serial')
    if not isinstance(serial, str) or not CASE_USB_SERIAL_RE.fullmatch(serial):
        raise RuntimeError('Case USB identity receipt serial is not one 16-hex value')
    raw_probe = receipt.get('raw_probe')
    if not isinstance(raw_probe, str) or not raw_probe.strip():
        raise RuntimeError('Case USB identity receipt has no raw USB probe evidence')
    if receipt.get('raw_probe_sha256') != hashlib.sha256(raw_probe.encode()).hexdigest():
        raise RuntimeError('Case USB identity receipt raw USB probe hash mismatch')
    row = select_exact_usb_row(raw_probe, 'SDPS', serial)
    for key, expected in (('chip', 'MX943'), ('vid', CASE_USB_SDPS_VID),
                          ('pid', CASE_USB_SDPS_PID), ('serial', serial)):
        if usb.get(key) != expected:
            raise RuntimeError('Case USB identity receipt ' + key
                               + ' does not match its raw probe row')
    if usb.get('path') != row['path'] or usb.get('bcd_version') != row['bcd_version']:
        raise RuntimeError('Case USB identity receipt path/BcdVersion does not match its raw probe row')
    return receipt, sha256_file(path)

def record_usb_receipt_consumption(binding, receipt, receipt_sha256, phase, operation):
    record = {
        'time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'phase': phase,
        'operation': operation,
        'case_id': binding['case_id'],
        'artifact_binding': binding['key'],
        'artifact_id': binding['id'],
        'artifact_size': binding['size'],
        'artifact_sha256': binding['sha256'],
        'usb_serial': receipt['usb']['serial'],
        'usb_protocol': receipt['usb']['protocol'],
        'usb_vid_pid': receipt['usb']['vid'] + ':' + receipt['usb']['pid'],
        'usb_identity_receipt_sha256': receipt_sha256,
    }
    path = binding['case_root'] / CASE_USB_CONSUMPTION_REL
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a', encoding='utf-8') as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + '\n')
        handle.flush()
        os.fsync(handle.fileno())
    return record

def confirm_case_usb_identity():
    """Read-only identity confirmation that atomically records a case receipt.

    It accepts no serial, path, hash or evidence argument.  The serial comes
    only from the single exact SDPS row observed by this invocation, and the
    BCU identity must have been established by bcu_identity in this session.
    """
    binding = load_case_artifact()
    verify_case_software_state(binding)
    if not IDENTITY or not IDENTITY_OUTPUT:
        raise RuntimeError('Run bcu_identity in this session before confirming case USB identity')
    receipt_path = case_usb_receipt_path(binding)
    if receipt_path.exists():
        receipt, digest = load_usb_identity_receipt(binding)
        one_board()
        output = run(['sudo', '-n', UUU, '-lsusb'])
        rows = parse_uuu_usb_table(output)
        protocol = rows[0]['protocol']
        require_exact_usb_row(output, protocol, receipt['usb']['serial'])
        return json.dumps({'status': 'reused', 'receipt_sha256': digest,
                           'scope': 'usb_identity_only', 'protocol': protocol})
    one_board()
    usb_before = run(['sudo', '-n', UUU, '-lsusb'])
    row = select_exact_usb_row(usb_before, 'SDPS')
    timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
    bcu_raw = IDENTITY_OUTPUT
    receipt = {
        'schema_version': CASE_USB_RECEIPT_SCHEMA,
        'status': CASE_USB_RECEIPT_STATUS,
        'scope': CASE_USB_RECEIPT_SCOPE,
        'case_id': binding['case_id'],
        'timestamp': timestamp,
        'artifact': {
            'binding_key': binding['key'],
            'artifact_id': binding['id'],
            'case_relative_path': binding['relative_path'],
            'size': binding['size'],
            'sha256': binding['sha256'],
            'build_recipe': binding['build_recipe'],
            'target_module': binding['target_module'],
        },
        'bcu_identity': {
            'board': BOARD,
            'ftdi_serial': ADAPTER,
            'soc_revision': 'A0',
            'pmic': 'MFS5600',
            'observed_at': IDENTITY_TIME or timestamp,
            'raw_output': bcu_raw,
            'raw_output_sha256': hashlib.sha256(bcu_raw.encode()).hexdigest(),
        },
        'usb': {
            'protocol': 'SDPS',
            'chip': row['chip'],
            'vid': row['vid'],
            'pid': row['pid'],
            'serial': row['serial'],
            'path': row['path'],
            'bcd_version': row['bcd_version'],
        },
        'raw_probe': usb_before,
        'raw_probe_sha256': hashlib.sha256(usb_before.encode()).hexdigest(),
    }
    atomic_write_json(receipt_path, receipt)
    return json.dumps({
        'status': 'confirmed',
        'case_id': binding['case_id'],
        'artifact_sha256': binding['sha256'],
        'serial': row['serial'],
        'protocol': 'SDPS',
        'vid_pid': row['vid'] + ':' + row['pid'],
        'receipt': CASE_USB_RECEIPT_REL,
        'scope': 'usb_identity_only',
        'ram_boot': 'not performed or claimed',
        'runtime': 'not performed or claimed',
    }, ensure_ascii=False, indent=2)

SPL_RECIPE_FILE = '_flash.bin'
SPL_SDPS_BOOT_RE = re.compile(
    r'^[ \t]*SDPS(?:\[-t [0-9]+\])?: boot -f (?P<file>\S+)[ \t]*$')
SPL_SDPV_DELAY_RE = re.compile(r'^[ \t]*SDPV: delay [0-9]+[ \t]*$')
SPL_SDPV_WRITE_RE = re.compile(
    r'^[ \t]*SDPV: write -f (?P<file>\S+)(?: -skipspl)?[ \t]*$')
SPL_SDPV_JUMP_RE = re.compile(r'^[ \t]*SDPV: jump[ \t]*$')
SPL_SDPV_DONE_RE = re.compile(r'^[ \t]*SDPV: done[ \t]*$')
SPL_SDP_BOOT_RE = re.compile(r'^[ \t]*SDP: boot -f (?P<file>\S+)[ \t]*$')
SPL_SDPU_DELAY_RE = re.compile(r'^[ \t]*SDPU: delay [0-9]+[ \t]*$')
SPL_SDPU_WRITE_RE = re.compile(
    r'^[ \t]*SDPU: write -f (?P<file>\S+) -offset 0[xX][0-9A-Fa-f]+[ \t]*$')
SPL_SDPU_JUMP_RE = re.compile(r'^[ \t]*SDPU: jump[ \t]*$')
SPL_SDPU_DONE_RE = re.compile(r'^[ \t]*SDPU: done[ \t]*$')
SPL_PROTOCOL_LINE_RE = re.compile(
    r'^[ \t]*(?P<protocol>SDPS|SDPV|SDPU|SDP|FB)\b')

def require_spl_recipe(output):
    """Require the reviewed RAM-only SPL recipe, line by line.

    Installed UUU 1.5.243 prints both the plain ``SDPS:`` form and the real
    ``SDPS[-t 10000]:`` timeout-modified form.  Parse protocol lines instead
    of free-text substrings; bind every boot/write to ``_flash.bin``; require
    the active SDPS boot and SDPV jump phases in order; and reject any FB
    storage command.  The installed built-in script also contains comments and
    inactive SDP/SDPU families, which are accepted only in their exact reviewed
    forms and still have their file references bound.
    """
    sdps_boot = False
    sdpv_write = False
    sdpv_jump = False
    sdpv_done = False
    for raw_line in output.splitlines():
        line = raw_line.rstrip('\r')
        if not line.strip() or line.lstrip().startswith('#') or re.fullmatch(r'uuu_version [0-9.]+', line.strip()):
            continue
        match = SPL_SDPS_BOOT_RE.match(line)
        if match:
            if sdps_boot:
                raise RuntimeError('Installed UUU spl recipe has multiple SDPS boot phases')
            if match.group('file') != SPL_RECIPE_FILE:
                raise RuntimeError('Installed UUU spl recipe boots a file other than _flash.bin')
            sdps_boot = True
            continue
        match = SPL_SDPV_DELAY_RE.match(line)
        if match:
            if not sdps_boot or sdpv_write or sdpv_jump:
                raise RuntimeError('Installed UUU spl recipe has SDPV delay outside the pre-jump phase')
            continue
        match = SPL_SDPV_WRITE_RE.match(line)
        if match:
            if not sdps_boot or sdpv_jump:
                raise RuntimeError('Installed UUU spl recipe has SDPV write outside the boot phase')
            if sdpv_write:
                raise RuntimeError('Installed UUU spl recipe has multiple SDPV write phases')
            if match.group('file') != SPL_RECIPE_FILE:
                raise RuntimeError('Installed UUU spl recipe writes a file other than _flash.bin')
            sdpv_write = True
            continue
        match = SPL_SDPV_JUMP_RE.match(line)
        if match:
            if not sdps_boot:
                raise RuntimeError('Installed UUU spl recipe has SDPV jump before SDPS boot')
            if sdpv_jump:
                raise RuntimeError('Installed UUU spl recipe has multiple SDPV jump phases')
            sdpv_jump = True
            continue
        match = SPL_SDPV_DONE_RE.match(line)
        if match:
            if not sdpv_jump or sdpv_done:
                raise RuntimeError('Installed UUU spl recipe has SDPV done outside the jump phase')
            sdpv_done = True
            continue
        # Inactive families in the installed built-in spl script.  They are
        # accepted only in the reviewed exact forms and with the same file.
        match = (SPL_SDP_BOOT_RE.match(line) or SPL_SDPU_DELAY_RE.match(line)
                 or SPL_SDPU_WRITE_RE.match(line) or SPL_SDPU_JUMP_RE.match(line)
                 or SPL_SDPU_DONE_RE.match(line))
        if match:
            if 'file' in match.groupdict() and match.group('file') != SPL_RECIPE_FILE:
                raise RuntimeError('Installed UUU spl recipe references a file other than _flash.bin')
            continue
        protocol = SPL_PROTOCOL_LINE_RE.match(line)
        if protocol:
            if protocol.group('protocol') == 'FB':
                raise RuntimeError('Installed UUU spl recipe contains a storage write; refusing RAM boot')
            raise RuntimeError('Installed UUU spl recipe contains a malformed or unrelated protocol line')
        raise RuntimeError('Installed UUU spl recipe contains an unreviewed line')
    if not sdps_boot or not sdpv_jump:
        raise RuntimeError('Installed UUU spl recipe is not the reviewed RAM-boot recipe')

def require_sd_bootloader_recipe(output):
    required = ('FB: ucmd setenv fastboot_dev mmc', 'FB: ucmd mmc dev ${sd_dev}',
                'FB: flash bootloader _image', 'FB: Done')
    if not all(value in output for value in required):
        raise RuntimeError('Installed UUU sd recipe is not the reviewed explicit-sd_dev bootloader recipe')

def require_case_write_markers(output):
    required = ('Start Cmd:FB: ucmd mmc dev ${sd_dev}',
                'Start Cmd:FB: flash bootloader',
                'Start Cmd:FB: Done')
    if not all(value in output for value in required):
        raise RuntimeError('UUU exited without explicit case SD-bootloader completion markers')

def require_completed_case(path, binding, phase):
    if not path.is_file():
        raise RuntimeError('Required completed receipt missing: ' + path.name)
    receipt = json.loads(path.read_text())
    if receipt.get('status') != 'completed':
        raise RuntimeError('Completed receipt status invalid: ' + path.name)
    if receipt.get('artifact_binding') != binding['key']:
        raise RuntimeError('Completed receipt binding invalid: ' + path.name)
    if receipt.get('artifact_id') != binding['id']:
        raise RuntimeError('Completed receipt artifact id invalid: ' + path.name)
    if receipt.get('artifact_size') != binding['size']:
        raise RuntimeError('Completed receipt size invalid: ' + path.name)
    if receipt.get('artifact_sha256') != binding['sha256']:
        raise RuntimeError('Completed receipt hash invalid: ' + path.name)
    if receipt.get('build_recipe') != binding['build_recipe']:
        raise RuntimeError('Completed receipt build recipe invalid: ' + path.name)
    if receipt.get('target_module') != binding['target_module']:
        raise RuntimeError('Completed receipt target module invalid: ' + path.name)
    if receipt.get('phase') != phase:
        raise RuntimeError('Completed receipt phase invalid: ' + path.name)
    if phase == 'sd_bootloader' and receipt.get('sd_dev') != 1:
        raise RuntimeError('Completed SD-bootloader receipt does not prove explicit sd_dev=1')
    return receipt

