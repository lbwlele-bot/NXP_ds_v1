        transaction.update({'failed_time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                            'status': 'failed', 'error': str(exc)})
        with attempted.open('a') as handle:
            handle.write(json.dumps(transaction, ensure_ascii=False) + '\n')
        raise

